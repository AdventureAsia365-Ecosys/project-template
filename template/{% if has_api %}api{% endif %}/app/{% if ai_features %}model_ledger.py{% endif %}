"""Model-call ledger: one row per model call, refused and failed calls included, with what the provider billed.

Every model call goes through the gateway (gateway.py), which calls `record_call(...)` with the billed fields of the
provider's response (`billed_fields(resp)`), so cost is traceable per stage and role. The ledger also answers how much
was spent this month (`month_spend`), which the gateway reads to enforce its spend caps before each call. Tests use
`MemoryLedger`; deployed environments use `PostgresLedger` (the `model_call_log` table of migration 001).
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import UTC, datetime
from typing import Any, Protocol

from psycopg import sql

OUTCOMES = ("ok", "refused", "error")
COLUMNS = (
    "stage",
    "role",
    "provider",
    "model",
    "outcome",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "latency_ms",
    "created_at",
)


def billed_fields(resp: dict[str, Any]) -> dict[str, Any]:
    """The billed tokens and cost of a provider response (a dict with a `usage` block)."""
    usage = resp.get("usage") or {}
    return {
        "input_tokens": int(usage.get("input_tokens", 0)),
        "output_tokens": int(usage.get("output_tokens", 0)),
        "cost_usd": float(usage.get("cost_usd", 0.0)),
    }


class Ledger(Protocol):
    def write(self, row: dict[str, Any]) -> None: ...

    def month_spend(self, since: datetime, provider: str | None = None) -> float: ...


@dataclass
class MemoryLedger:
    rows: list[dict[str, Any]] = field(default_factory=list)

    def write(self, row: dict[str, Any]) -> None:
        self.rows.append(row)

    def month_spend(self, since: datetime, provider: str | None = None) -> float:
        rows = (r for r in self.rows if r["created_at"] >= since)
        return sum(r["cost_usd"] for r in rows if provider is None or r["provider"] == provider)


class PostgresLedger:
    """The `model_call_log` table."""

    def __init__(self, pool: Any, schema: str) -> None:
        self._pool = pool
        table = sql.SQL("{}.model_call_log").format(sql.Identifier(schema))
        self._insert = sql.SQL("INSERT INTO {} ({}) VALUES ({})").format(
            table,
            sql.SQL(", ").join(map(sql.Identifier, COLUMNS)),
            sql.SQL(", ").join(sql.Placeholder(c) for c in COLUMNS),
        )
        self._spend = sql.SQL(
            "SELECT coalesce(sum(cost_usd), 0) FROM {} "
            "WHERE created_at >= %(since)s AND (%(provider)s::text IS NULL OR provider = %(provider)s)"
        ).format(table)

    def write(self, row: dict[str, Any]) -> None:
        with self._pool.connection() as conn:
            conn.execute(self._insert, row)

    def month_spend(self, since: datetime, provider: str | None = None) -> float:
        with self._pool.connection() as conn:
            return float(conn.execute(self._spend, {"since": since, "provider": provider}).fetchone()[0])


def record_call(
    ledger: Ledger,
    *,
    stage: str,
    role: str,
    provider: str,
    model: str,
    outcome: str,
    input_tokens: int = 0,
    output_tokens: int = 0,
    cost_usd: float = 0.0,
    latency_ms: int | None = None,
    at: datetime | None = None,
) -> dict[str, Any]:
    if outcome not in OUTCOMES:
        raise ValueError(f"outcome must be one of {OUTCOMES}")
    row = {
        "stage": stage,
        "role": role,
        "provider": provider,
        "model": model,
        "outcome": outcome,
        "input_tokens": input_tokens,
        "output_tokens": output_tokens,
        "cost_usd": cost_usd,
        "latency_ms": latency_ms,
        "created_at": at or datetime.now(UTC),
    }
    ledger.write(row)
    return row
