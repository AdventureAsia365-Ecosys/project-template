"""Model gateway core: the one client every model call goes through.

- Routing by role: a role (writer, judge, ...) names an ordered list of targets (provider and model). Code asks for
  a role, never for a provider. The routes are data an administrator edits (`/admin/model-routes`, every change
  audited), kept behind `RouteStore`: `MemoryRouteStore` for tests and local runs, `PostgresRouteStore` (the
  `model_route` and `model_route_audit` tables of migration 002) in deployed environments. The gateway reads the
  route on every call, so a change takes effect at once; a save is refused when it names a provider that is not
  registered (the picker is `Gateway.provider_names()`), and every registered provider has a cap setting.
- Ordered fallback: when a target fails, or its provider's monthly cap would be passed, the next target is tried.
  A `FatalProviderError` (a request the provider will never accept) stops the chain instead.
- Spend caps, enforced before the call and fail-closed: the month's spend in the ledger plus the provider's estimate
  for this call must stay within the total cap (`ai.monthly_cap_usd`) and the provider's cap
  (`ai.monthly_cap_usd.<provider>`). Both are settings an administrator edits (settings_registry.py); a provider
  without a cap setting is a configuration error at start-up. When the ledger cannot be read, no call is made.
- One ledger row per attempt (model_ledger.py), refused and failed attempts included, with `billed_fields(resp)`.

Parallel calls each check the cap before they run, so together they can pass it by at most their own estimates.

Providers implement `Provider`; this module ships only `FakeProvider` (tests and local runs, no network, no key).
A real provider is a small adapter in its own module: it reads its key from the secret store at run time, maps the
request to the vendor's API and returns `{"text": ..., "usage": {"input_tokens", "output_tokens", "cost_usd"}}`.
"""

from __future__ import annotations

import time
from collections.abc import Callable
from dataclasses import dataclass, field
from datetime import UTC, datetime
from typing import Any, Protocol

from psycopg import sql
from psycopg.types.json import Jsonb

from .model_ledger import Ledger, billed_fields, record_call
from .settings_registry import Setting, SettingsRegistry

TOTAL_CAP = "ai.monthly_cap_usd"

# The gateway's settings; app/wiring.py adds them, with one `provider_cap(...)` per provider the routes use.
GATEWAY_SETTINGS: tuple[Setting, ...] = (
    Setting(TOTAL_CAP, 20, 0, 1_000_000, "Model spend allowed per calendar month (UTC), all providers, in USD."),
)


def provider_cap(provider: str, default: int = 10) -> Setting:
    """The monthly cap setting of one provider. 0 turns the provider off."""
    return Setting(f"{TOTAL_CAP}.{provider}", default, 0, 1_000_000, f"Model spend per month on {provider}, in USD.")


@dataclass(frozen=True)
class Target:
    provider: str
    model: str


@dataclass(frozen=True)
class Request:
    prompt: str
    max_output_tokens: int = 512
    options: dict[str, Any] = field(default_factory=dict)


@dataclass(frozen=True)
class Result:
    text: str
    provider: str
    model: str
    response: dict[str, Any]


class Provider(Protocol):
    name: str

    def complete(self, model: str, request: Request) -> dict[str, Any]: ...

    def estimate_cost_usd(self, model: str, request: Request) -> float: ...


class GatewayError(RuntimeError):
    """No answer: every target failed or was refused."""


class CapExceeded(GatewayError):
    """The total monthly cap would be passed; no provider is tried."""


class FatalProviderError(RuntimeError):
    """Raised by a provider for a request no provider would accept (the chain stops)."""


class RouteError(ValueError):
    """A route that may not be saved: no target, an unknown provider, an empty model or a repeated target."""


@dataclass(frozen=True)
class RouteChange:
    role: str
    old: list[Target]
    new: list[Target]
    changed_by: str
    changed_at: datetime


def targets_json(targets: list[Target]) -> list[dict[str, str]]:
    return [{"provider": t.provider, "model": t.model} for t in targets]


class RouteStore(Protocol):
    def load(self, role: str) -> list[Target]: ...

    def all(self) -> dict[str, list[Target]]: ...

    def save(self, role: str, targets: list[Target], changed_by: str, at: datetime) -> RouteChange:
        """Replace the role's targets and write its audit row together; the old targets are read under one lock."""
        ...


@dataclass
class MemoryRouteStore:
    routes: dict[str, list[Target]] = field(default_factory=dict)
    audit: list[RouteChange] = field(default_factory=list)

    def load(self, role: str) -> list[Target]:
        return list(self.routes.get(role, []))

    def all(self) -> dict[str, list[Target]]:
        return {role: list(targets) for role, targets in sorted(self.routes.items())}

    def save(self, role: str, targets: list[Target], changed_by: str, at: datetime) -> RouteChange:
        change = RouteChange(role, self.load(role), list(targets), changed_by, at)
        self.routes[role] = list(targets)
        self.audit.append(change)
        return change


class PostgresRouteStore:
    """The `model_route` (one row per target, in order) and `model_route_audit` tables."""

    def __init__(self, pool: Any, schema: str) -> None:
        self._pool = pool

        def q(text: str) -> sql.Composed:
            return sql.SQL(text).format(schema=sql.Identifier(schema))

        self._load = q("SELECT provider, model FROM {schema}.model_route WHERE role = %(role)s ORDER BY position")
        self._all = q("SELECT role, provider, model FROM {schema}.model_route ORDER BY role, position")
        self._delete = q("DELETE FROM {schema}.model_route WHERE role = %(role)s")
        self._insert = q(
            "INSERT INTO {schema}.model_route (role, position, provider, model) "
            "VALUES (%(role)s, %(position)s, %(provider)s, %(model)s)"
        )
        self._audit = q(
            "INSERT INTO {schema}.model_route_audit (role, old_targets, new_targets, changed_by, changed_at) "
            "VALUES (%(role)s, %(old)s, %(new)s, %(by)s, %(at)s)"
        )
        self._lock = f"{schema}.model_route:"

    def load(self, role: str) -> list[Target]:
        with self._pool.connection() as conn:
            return [Target(*row) for row in conn.execute(self._load, {"role": role}).fetchall()]

    def all(self) -> dict[str, list[Target]]:
        routes: dict[str, list[Target]] = {}
        with self._pool.connection() as conn:
            for role, provider, model in conn.execute(self._all).fetchall():
                routes.setdefault(role, []).append(Target(provider, model))
        return routes

    def save(self, role: str, targets: list[Target], changed_by: str, at: datetime) -> RouteChange:
        with self._pool.connection() as conn, conn.transaction():
            conn.execute("SELECT pg_advisory_xact_lock(hashtext(%s))", (self._lock + role,))
            old = [Target(*row) for row in conn.execute(self._load, {"role": role}).fetchall()]
            conn.execute(self._delete, {"role": role})
            for position, t in enumerate(targets, start=1):
                row = {"role": role, "position": position, "provider": t.provider, "model": t.model}
                conn.execute(self._insert, row)
            args = {"role": role, "by": changed_by, "at": at}
            conn.execute(self._audit, {**args, "old": Jsonb(targets_json(old)), "new": Jsonb(targets_json(targets))})
        return RouteChange(role, old, list(targets), changed_by, at)


@dataclass
class FakeProvider:
    """A scripted provider: each call takes the next item of `script` (a response dict, or an exception to raise)."""

    name: str
    script: list[Any] = field(default_factory=list)
    price_usd: float = 0.01
    calls: list[tuple[str, Request]] = field(default_factory=list)

    def complete(self, model: str, request: Request) -> dict[str, Any]:
        self.calls.append((model, request))
        item = self.script.pop(0) if self.script else self.default_response(request)
        if isinstance(item, BaseException):
            raise item
        return item

    def default_response(self, request: Request) -> dict[str, Any]:
        usage = {"input_tokens": len(request.prompt.split()), "output_tokens": 8, "cost_usd": self.price_usd}
        return {"text": f"[{self.name}] ok", "usage": usage}

    def estimate_cost_usd(self, model: str, request: Request) -> float:
        return self.price_usd


def month_start(now: datetime) -> datetime:
    return now.astimezone(UTC).replace(day=1, hour=0, minute=0, second=0, microsecond=0)


class Gateway:
    """`routes` is a route store, or a dict of seed routes for tests and local runs (checked, then kept in memory)."""

    def __init__(
        self,
        providers: list[Provider],
        routes: RouteStore | dict[str, list[Target]],
        ledger: Ledger,
        settings: SettingsRegistry,
        clock: Callable[[], datetime] = lambda: datetime.now(UTC),
    ) -> None:
        self._providers = {p.name: p for p in providers}
        self._ledger, self._settings, self._clock = ledger, settings, clock
        if not settings.has(TOTAL_CAP):
            raise ValueError(f"the settings registry lacks {TOTAL_CAP} (GATEWAY_SETTINGS)")
        for name in self._providers:
            if not settings.has(provider_cap(name).key):
                raise ValueError(f"provider {name} has no cap setting (add provider_cap({name!r}) to the settings)")
        if isinstance(routes, dict):
            for role, targets in routes.items():
                self.check_route(role, targets)
            routes = MemoryRouteStore({role: list(targets) for role, targets in routes.items()})
        self._routes: RouteStore = routes

    def provider_names(self) -> list[str]:
        """The providers a route may name (the administrator's picker)."""
        return sorted(self._providers)

    def routes(self) -> dict[str, list[Target]]:
        return self._routes.all()

    def check_route(self, role: str, targets: list[Target]) -> None:
        if not role.strip():
            raise RouteError("a route needs a role")
        if not targets:
            raise RouteError(f"route {role}: at least one target (a provider is turned off with its cap set to 0)")
        for t in targets:
            if t.provider not in self._providers:
                raise RouteError(f"route {role}: unknown provider {t.provider}; registered: {self.provider_names()}")
            if not t.model.strip():
                raise RouteError(f"route {role}: provider {t.provider} needs a model")
        if len(set(targets)) != len(targets):
            raise RouteError(f"route {role}: a target appears twice")

    def set_route(self, role: str, targets: list[Target], changed_by: str) -> RouteChange:
        """Check and save a role's ordered targets; the store writes the audit row with the change."""
        self.check_route(role, targets)
        return self._routes.save(role, list(targets), changed_by, self._clock())

    def _record(self, stage: str, role: str, target: Target, outcome: str, resp: dict, latency_ms: int | None) -> None:
        record_call(
            self._ledger,
            stage=stage,
            role=role,
            provider=target.provider,
            model=target.model,
            outcome=outcome,
            latency_ms=latency_ms,
            at=self._clock(),
            **billed_fields(resp),
        )

    def _within_caps(self, target: Target, estimate: float) -> tuple[bool, bool]:
        """(total cap ok, provider cap ok). Raises when the ledger cannot be read: the caller makes no call."""
        since = month_start(self._clock())
        total_cap = self._settings.get(TOTAL_CAP)
        own_cap = self._settings.get(provider_cap(target.provider).key)
        total = self._ledger.month_spend(since)
        own = self._ledger.month_spend(since, target.provider)
        return (total < total_cap and total + estimate <= total_cap, own < own_cap and own + estimate <= own_cap)

    def generate(self, role: str, stage: str, request: Request) -> Result:
        """Answer `request` with the first target of `role` that is within its caps and succeeds."""
        targets = self._routes.load(role)
        if not targets:
            raise GatewayError(f"no route for role {role}")
        failures: list[str] = []
        for target in targets:
            provider = self._providers.get(target.provider)
            if provider is None:  # a stored route that names a provider no longer registered: not an attempt
                failures.append(f"{target.provider}: not registered")
                continue
            try:
                total_ok, own_ok = self._within_caps(target, provider.estimate_cost_usd(target.model, request))
            except Exception as e:  # fail closed: no spend figure, no call
                raise GatewayError(f"spend check failed, no call made: {e}") from e
            if not total_ok:
                self._record(stage, role, target, "refused", {}, None)
                raise CapExceeded(f"monthly model spend cap {self._settings.get(TOTAL_CAP)} USD reached")
            if not own_ok:
                self._record(stage, role, target, "refused", {}, None)
                failures.append(f"{target.provider}: monthly cap reached")
                continue
            started = time.monotonic()
            try:
                resp = provider.complete(target.model, request)
            except FatalProviderError:
                self._record(stage, role, target, "error", {}, int((time.monotonic() - started) * 1000))
                raise
            except Exception as e:  # noqa: BLE001 - recorded, then the next target is tried
                self._record(stage, role, target, "error", {}, int((time.monotonic() - started) * 1000))
                failures.append(f"{target.provider}: {type(e).__name__}")
                continue
            self._record(stage, role, target, "ok", resp, int((time.monotonic() - started) * 1000))
            return Result(str(resp.get("text", "")), target.provider, target.model, resp)
        raise GatewayError(f"every target of {role} failed: {'; '.join(failures)}")
