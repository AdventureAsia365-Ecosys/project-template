"""{{ project_name }} API: health, readiness, the deploy gate and the admin settings endpoints.

/health        200 with the commit SHA the process runs (GIT_SHA, set at image build) - the "verified live" check
/health/ready  200 when the dependencies answer (the database when DATABASE_URL is set), 503 otherwise
/deploy-gate   {"open": bool, "busy_jobs": n}: CI refuses a backend deploy or a migration while jobs run
/admin/settings[/<key>]  list and change the settings registry; administrator role only, every change audited

Identity is wired on day 1 (ADR "identity"): until then `current_role` refuses every admin call.
"""

from __future__ import annotations

import os
from collections.abc import AsyncIterator, Callable
from contextlib import asynccontextmanager
from datetime import UTC, datetime
from typing import Any

from fastapi import Depends, FastAPI, HTTPException, Request
from pydantic import BaseModel

from .jobs import JobStore
from .settings_registry import SettingError, SettingsRegistry
from .wiring import build_stores, database_ready, pool_from_env

ADMIN_ROLE = "administrator"


def no_identity(request: Request) -> str:
    raise HTTPException(status_code=401, detail="sign-in is not wired yet")


def readiness_checks(pool: Any | None, extra: dict[str, Callable[[], bool]] | None) -> dict[str, Callable[[], bool]]:
    checks = dict(extra or {})
    if pool is not None:
        checks.setdefault("db", lambda: database_ready(pool))
    return checks


def pool_lifespan(pool: Any | None) -> Callable[[FastAPI], Any]:
    """Opens the database pool at start-up and closes it at shut-down (no-op without a pool)."""

    @asynccontextmanager
    async def lifespan(_: FastAPI) -> AsyncIterator[None]:
        if pool is None:
            yield
            return
        pool.open()
        try:
            yield
        finally:
            pool.close()

    return lifespan


class SettingChange(BaseModel):
    value: int


def create_app(
    jobs: JobStore | None = None,
    settings: SettingsRegistry | None = None,
    current_role: Callable[[Request], str] = no_identity,
    ready_checks: dict[str, Callable[[], bool]] | None = None,
    pool: Any | None = None,
) -> FastAPI:
    """With `pool` (a closed psycopg pool) the stores are the database ones; the app opens the pool at start-up."""
    stores = build_stores(pool)
    jobs = jobs or stores.jobs
    settings = settings or stores.settings
    checks = readiness_checks(pool, ready_checks)
    app = FastAPI(title="{{ project_name }} API", lifespan=pool_lifespan(pool))

    def require_admin(request: Request) -> str:
        role = current_role(request)
        if role != ADMIN_ROLE:
            raise HTTPException(status_code=403, detail="administrator role required")
        return role

    @app.get("/health")
    def health() -> dict:
        return {"status": "ok", "sha": os.environ.get("GIT_SHA", "unknown")}

    @app.get("/health/ready")
    def ready() -> dict:
        failed = [name for name, check in checks.items() if not check()]
        if failed:
            raise HTTPException(status_code=503, detail={"failed": failed})
        return {"status": "ready", "checks": sorted(checks)}

    @app.get("/deploy-gate")
    def deploy_gate() -> dict:
        busy = jobs.busy_count(datetime.now(UTC))
        return {"open": busy == 0, "busy_jobs": busy}

    @app.get("/admin/settings")
    def list_settings(_: str = Depends(require_admin)) -> list[dict]:
        return [
            {
                "key": s.key,
                "value": settings.get(s.key),
                "default": s.default,
                "minimum": s.minimum,
                "maximum": s.maximum,
                "description": s.description,
            }
            for s in settings.definitions()
        ]

    @app.put("/admin/settings/{key}")
    def change_setting(key: str, change: SettingChange, role: str = Depends(require_admin)) -> dict:
        try:
            entry = settings.set(key, change.value, changed_by=role)
        except SettingError as e:
            raise HTTPException(status_code=422, detail=str(e)) from e
        return {"key": entry.key, "old": entry.old, "new": entry.new}

    return app


app = create_app(pool=pool_from_env())
