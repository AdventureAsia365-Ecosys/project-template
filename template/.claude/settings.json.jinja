{
  "permissions": {
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(gh auth token:*)",
      "Bash(aws configure get:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-guardrails.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell-guard.sh"
          }{% if pii_guard %},
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pii-guard.sh"
          }{% endif %}
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-mcp-guardrails.sh"
          }
        ]
      }
    ]{% if stop_hook %},
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-open-work.sh"
          }
        ]
      }
    ]{% endif %}
  }
}
