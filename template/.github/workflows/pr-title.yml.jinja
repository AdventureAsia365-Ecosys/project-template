name: PR title
# The squash-merge commit takes the PR title: it must be a Conventional Commit title (release-please reads it) without
# an issue key. The body names issues only on a "Refs {{ issue_key_prefix }}-<n>" line and never with a closing keyword, because
# the tracker would close the issue on merge; an issue is Done only after deploy and a live check.
on:
  pull_request:
    types: [opened, edited, synchronize, reopened]
    branches: [{{ default_branch }}]

permissions:
  pull-requests: read

concurrency:
  group: pr-title-{% raw %}${{ github.event.pull_request.number || github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  title:
    name: PR title
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Conventional title without an issue key
        uses: amannn/action-semantic-pull-request@2252a14e810aa9b85c2d560bd7070c802206ecf6 # v6.1.2
        env:
          GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        with:
          types: |
            feat
            fix
            chore
            refactor
            docs
            ci
            test
            perf
          requireScope: false
          subjectPattern: ^(?!.*\b{{ issue_key_prefix }}-\d+\b).+$
          subjectPatternError: |
            The title "{title}" carries an issue key. Remove it from the title and put
            "Refs {{ issue_key_prefix }}-..." in the PR body instead.

      - name: Issue keys only on the Refs line, no closing keywords
        env:
          BODY: {% raw %}${{ github.event.pull_request.body }}{% endraw %}
        shell: python3 {0}
        run: |
          import os, re, sys
          body = os.environ.get("BODY", "").replace("\r", "")
          closing = re.compile(r"(?<![0-9A-Za-z])(close[sd]?|closing|fix(e[sd])?|fixing|resolve[sd]?|resolving"
                               r"|complete[sd]?|completing)[\s:*_`\[(\-]*{{ issue_key_prefix }}-\d+", re.IGNORECASE)
          hits = [line for line in body.splitlines() if closing.search(line)]
          if hits:
              print("\n".join(hits[:5]))
              print("::error title=Closing keyword::Use 'Refs {{ issue_key_prefix }}-123' in the PR body; a closing keyword closes the "
                    "issue on merge, before deploy and the live check.")
              sys.exit(1)
          print("PR body: no closing keyword")
