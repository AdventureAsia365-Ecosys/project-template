#!/bin/bash
# Fast checks: what the pre-push hook runs and what CI runs first. Prints one line per check and a summary.
set -uo pipefail
cd "$(dirname "$0")/.."
log=$(mktemp)
failed=""
nfail=0
run() { local name=$1; shift; if "$@" >"$log" 2>&1; then echo "ok    $name"; else echo "FAIL  $name"; tail -20 "$log"; failed="$failed $name"; nfail=$((nfail+1)); fi; }

run "docs links" python3 tools/check_links.py .
run "resource-id lint" python3 tools/resource_id_lint.py --mode error .
run "code health" python3 .github/scripts/code_health.py
run "hook: subagent guardrails" bash .claude/hooks/test_subagent_guardrails_generic.sh
run "hook: MCP guardrails" bash .claude/hooks/test_subagent_mcp_guardrails.sh
run "hook: shell guard" python3 .claude/hooks/test_shell_guard_core.py
run "hook: settings" python3 .claude/hooks/test_settings_hooks.py
{%- if stop_hook %}
run "hook: stop open work" python3 .claude/hooks/test_stop_open_work.py
{%- endif %}
{%- if pii_guard %}
run "hook: personal-data guard" python3 .claude/hooks/test_pii_guard.py
{%- endif %}
{%- if has_api_contract %}
run "api contract script" python3 .github/scripts/test_openapi_breaking.py
{%- endif %}
{%- if has_api %}
if [ -x api/.venv/bin/python ]; then
  run "api tests" bash -c 'cd api && .venv/bin/python -m pytest -q -p no:cacheprovider'
else
  echo "skip  api tests (no api/.venv: python3 -m venv api/.venv && api/.venv/bin/pip install -r api/requirements-dev.txt)"
fi
{%- endif %}
{%- if has_lambda %}
run "lambda tests" python3 -m unittest discover -s lambda -p 'test_*.py'
{%- endif %}
{%- if has_web %}
if command -v node >/dev/null; then
  run "web unit tests (kit lint)" bash -c 'cd web && npm test --silent'
  run "uat harness tests" bash -c 'cd tools/uat && npm test --silent'
else
  echo "skip  web unit tests and uat harness tests (no node on PATH)"
fi
if [ -d web/node_modules ]; then
  run "web typecheck" bash -c 'cd web && npm run --silent typecheck'
else
  echo "skip  web typecheck (no web/node_modules: cd web && npm install)"
fi
if [ -d tools/uat/node_modules ]; then
  run "uat harness typecheck" bash -c 'cd tools/uat && npm run --silent typecheck'
else
  echo "skip  uat harness typecheck (no tools/uat/node_modules: cd tools/uat && npm install)"
fi
{%- endif %}
rm -f "$log"
if [ "$nfail" -gt 0 ]; then echo "pre-push: $nfail check(s) failed:$failed"; exit 1; fi
echo "pre-push: all checks passed"
